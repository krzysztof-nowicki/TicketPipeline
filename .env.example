# Temporal Connection Settings
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ticket-processing-queue

# LLM Provider Configuration
# Set to 'fake' for keyless, offline deterministic agent processing
# Set to 'openai' for live model execution
# Set to 'local_llm' (or 'local') for local server (llama.cpp, ollama, etc.)
LLM_MODE=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local LLM Server Settings
LOCAL_SERVER_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.gguf
LOCAL_LLM_API_KEY=not-needed

# Helpdesk Simulation Settings
# Float between 0.0 and 1.0 (e.g. 0.2 means 20% random transient failure rate)
# Fake simulation settings for testing purposes
ACTIVITYTOOLS_FAILURE_RATE=0.1

# Service & Logging
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
